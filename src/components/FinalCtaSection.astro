---
interface FinalCta {
  eyebrow: string;
  title: string;
  description: string;
  points: string[];
  primary: string;
  primaryHref: string;
  secondary: string;
  secondaryHref: string;
  helper: string;
}

interface Props {
  cta: FinalCta;
}

const { cta } = Astro.props;
const analyticsEventForHref = (href: string) => {
  if (href.startsWith("/free-audit")) return "free_audit_cta_clicked";
  if (href.startsWith("/estimate-request")) return "estimate_request_cta_clicked";
  return undefined;
};
---

<section class="final-cta" id="contact">
  <div class="container">
    <div class="final-cta-shell" data-motion-stagger>
      <div class="final-cta-copy" data-motion-reveal="left">
        <p class="eyebrow">{cta.eyebrow}</p>
        <h2>{cta.title}</h2>
        <p>{cta.description}</p>
      </div>

      <div class="final-cta-side" data-motion-reveal="right">
        <div class="final-cta-points">
          {cta.points.map((point) => <span>{point}</span>)}
        </div>
        <div class="final-cta-actions">
          <a class="button" href={cta.primaryHref} data-analytics-event={analyticsEventForHref(cta.primaryHref)} data-analytics-location="final-cta">{cta.primary}</a>
          <a class="button button-secondary" href={cta.secondaryHref} data-analytics-event={analyticsEventForHref(cta.secondaryHref)} data-analytics-location="final-cta-secondary">{cta.secondary}</a>
        </div>
        <p class="final-cta-helper">{cta.helper}</p>
      </div>
    </div>
  </div>
</section>
