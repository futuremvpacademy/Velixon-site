---
interface Props {
  enabled?: boolean;
}

const { enabled = false } = Astro.props;
---

{enabled && <aside
  class="consent-banner"
  data-consent-banner
  aria-labelledby="consent-banner-title"
  aria-describedby="consent-banner-description"
  hidden
>
  <div class="consent-banner-copy">
    <p class="tech-label">Your privacy</p>
    <h2 id="consent-banner-title">Help us improve Velixon</h2>
    <p id="consent-banner-description">
      Optional analytics show us which pages help visitors most. We do not use advertising cookies, and declining will not affect the site.
      <a href="/cookies/">Read the cookie and storage policy</a>.
    </p>
  </div>
  <div class="consent-banner-actions">
    <button class="button button-secondary" type="button" data-consent-decline>Decline analytics</button>
    <button class="button" type="button" data-consent-accept>Allow analytics</button>
  </div>
</aside>}

<script>
  // @ts-nocheck -- analytics and DOM capabilities are guarded before use.
  (() => {
    const banner = document.querySelector("[data-consent-banner]");
    const accept = banner?.querySelector("[data-consent-accept]");
    const decline = banner?.querySelector("[data-consent-decline]");
    let returnFocus = null;

    const analytics = () => window.velixonAnalytics;
    const publishVisibility = (visible) => {
      document.documentElement.dataset.consentBannerVisible = visible ? "true" : "false";
      window.dispatchEvent(new CustomEvent("velixon:consentbannerchange", {
        detail: { visible }
      }));
    };
    const show = (focus = false) => {
      if (!banner) {
        publishVisibility(false);
        return;
      }
      banner.hidden = false;
      publishVisibility(true);
      if (focus) banner.querySelector("button")?.focus({ preventScroll: true });
    };
    const hide = () => {
      if (banner) banner.hidden = true;
      publishVisibility(false);
      if (returnFocus instanceof HTMLElement) returnFocus.focus({ preventScroll: true });
      returnFocus = null;
    };

    if (banner && !analytics()?.getConsent()) show();
    else hide();

    accept?.addEventListener("click", () => {
      analytics()?.setConsent("granted");
      hide();
    });

    decline?.addEventListener("click", () => {
      analytics()?.setConsent("denied");
      hide();
    });

    document.addEventListener("click", (event) => {
      const trigger = event.target instanceof Element ? event.target.closest("[data-consent-settings]") : null;
      if (!trigger) return;
      event.preventDefault();
      returnFocus = trigger;
      show(true);
    });
  })();
</script>
