---
interface NavItem {
  label: string;
  href: string;
  activePrefixes?: string[];
}

interface NavCta {
  label: string;
  href: string;
  analyticsEvent?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  secondaryAnalyticsEvent?: string;
}

interface Props {
  companyName: string;
  logo: string;
  nav: NavItem[];
  cta: NavCta;
  currentPath?: string;
  replayIntro?: boolean;
}

const { companyName, logo, nav, cta, currentPath = "/" } = Astro.props;
const normalizePath = (path: string) => path.split(/[?#]/)[0].replace(/\/$/, "") || "/";
const normalizedCurrentPath = normalizePath(currentPath);
const isCtaActive = normalizedCurrentPath === normalizePath(cta.href);
const isSecondaryCtaActive = cta.secondaryHref
  ? normalizedCurrentPath === normalizePath(cta.secondaryHref)
  : false;
const isNavItemActive = (item: NavItem) => {
  const paths = [item.href, ...(item.activePrefixes ?? [])].map(normalizePath);
  return paths.some((path) =>
    normalizedCurrentPath === path || (path !== "/" && normalizedCurrentPath.startsWith(`${path}/`))
  );
};
---

<header class="site-header">
  <div class="container nav-shell">
    <a class="brand" href="/" aria-label={`${companyName} home`} data-navigation-location="header">
      <img class="brand-logo" src={logo} alt={`${companyName} logo`} width="432" height="288" decoding="async" />
      <span class="brand-name">{companyName}</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isNavItemActive(item) ? "page" : undefined} data-navigation-location="header">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="nav-cta-wrap">
      {cta.secondaryLabel && cta.secondaryHref && (
        <a
          class="nav-question nav-quote-cta"
          href={cta.secondaryHref}
          aria-current={isSecondaryCtaActive ? "page" : undefined}
          data-analytics-event={cta.secondaryAnalyticsEvent}
          data-analytics-location="site-header"
        >{cta.secondaryLabel}</a>
      )}
      <a
        class="button button-small nav-primary-cta"
        href={cta.href}
        aria-current={isCtaActive ? "page" : undefined}
        data-analytics-cta="free-audit"
        data-analytics-event={cta.analyticsEvent}
        data-analytics-location="site-header"
      ><span class="nav-cta-label-full">{cta.label}</span><span class="nav-cta-label-short">Free Audit</span></a>
    </div>
  </div>

  <div class="container mobile-nav-wrap">
    <details class="mobile-menu" data-mobile-menu>
      <summary aria-label="Open navigation menu" aria-controls="mobile-navigation" aria-expanded="false"><span>Menu</span><i aria-hidden="true"></i></summary>
      <nav class="mobile-nav" id="mobile-navigation" aria-label="Mobile navigation">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={isNavItemActive(item) ? "page" : undefined} data-navigation-location="mobile-menu">
              {item.label}<span aria-hidden="true">↗</span>
            </a>
          ))
        }
        {cta.secondaryLabel && cta.secondaryHref && (
          <a
            class="mobile-nav-question mobile-nav-quote-cta"
            href={cta.secondaryHref}
            aria-current={isSecondaryCtaActive ? "page" : undefined}
            data-analytics-event={cta.secondaryAnalyticsEvent}
            data-analytics-location="mobile-menu"
          >{cta.secondaryLabel}<span aria-hidden="true">↗</span></a>
        )}
        <a
          class="mobile-nav-cta"
          href={cta.href}
          aria-current={isCtaActive ? "page" : undefined}
          data-analytics-cta="free-audit"
          data-analytics-event={cta.analyticsEvent}
          data-analytics-location="mobile-menu"
        >{cta.label}<span aria-hidden="true">↗</span></a>
      </nav>
    </details>
  </div>
</header>

<script>
  // @ts-nocheck -- DOM element capabilities are guarded before use.
  (() => {
    document.querySelectorAll("[data-mobile-menu]").forEach((menu) => {
      const summary = menu.querySelector("summary");
      const desktopBreakpoint = window.matchMedia("(min-width: 1121px)");
      const ownedInertElements = new Set();
      let restoreFocusOnClose = false;

      const setBackgroundInert = (value) => {
        document.querySelectorAll(
          ".skip-link, .site-header .brand, .site-header .desktop-nav, .site-header .nav-cta-wrap, .site-content > main, .site-footer, .quick-contact, [data-consent-banner]"
        ).forEach((element) => {
          if (value) {
            if (element.hasAttribute("inert")) return;
            element.setAttribute("inert", "");
            ownedInertElements.add(element);
            return;
          }

          if (!ownedInertElements.has(element)) return;
          element.removeAttribute("inert");
          ownedInertElements.delete(element);
        });
      };

      const getFocusableElements = () => Array.from(
        menu.querySelectorAll("summary, a[href], button:not([disabled]), [tabindex]:not([tabindex='-1'])")
      ).filter((element) => !element.hasAttribute("hidden"));

      const closeMenu = ({ restoreFocus = false } = {}) => {
        restoreFocusOnClose = restoreFocus;
        menu.removeAttribute("open");
      };

      menu.querySelectorAll("a, [data-inquiry-open]").forEach((control) => control.addEventListener("click", () => closeMenu()));
      menu.addEventListener("toggle", () => {
        const isOpen = menu.hasAttribute("open");
        const label = summary?.querySelector("span");
        document.body.classList.toggle("mobile-menu-open", isOpen);
        setBackgroundInert(isOpen);
        summary?.setAttribute("aria-label", isOpen ? "Close navigation menu" : "Open navigation menu");
        summary?.setAttribute("aria-expanded", String(isOpen));
        if (label) label.textContent = isOpen ? "Close" : "Menu";

        if (isOpen) {
          restoreFocusOnClose = false;
          window.requestAnimationFrame(() => menu.querySelector(".mobile-nav a")?.focus({ preventScroll: true }));
        } else if (restoreFocusOnClose) {
          restoreFocusOnClose = false;
          summary?.focus({ preventScroll: true });
        }
      });

      menu.addEventListener("keydown", (event) => {
        if (!menu.hasAttribute("open")) return;

        if (event.key === "Escape") {
          event.preventDefault();
          closeMenu({ restoreFocus: true });
          return;
        }

        if (event.key !== "Tab") return;
        const focusable = getFocusableElements();
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (!first || !last) return;

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });

      desktopBreakpoint.addEventListener("change", (event) => {
        if (event.matches && menu.hasAttribute("open")) closeMenu();
      });
    });
  })();
</script>
