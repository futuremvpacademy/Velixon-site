---
interface NavItem {
  label: string;
  href: string;
}

interface SocialItem {
  label: string;
  href: string;
}

interface NavGroup {
  heading: string;
  ariaLabel: string;
  items: NavItem[];
}

interface Props {
  logo: string;
  companyName: string;
  nav: NavGroup[];
  footer: {
    blurb: string;
    email: string;
    socials: SocialItem[];
  };
  phone: string;
  analyticsEnabled?: boolean;
}

const { logo, companyName, nav, footer, phone, analyticsEnabled = false } = Astro.props;
const phoneHref = `tel:${phone.replace(/[^0-9+]/g, "")}`;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-conversion">
    <div class="footer-conversion-copy">
      <p class="footer-conversion-kicker">Have a workflow worth fixing?</p>
      <h2>Start with the process creating the most drag.</h2>
      <p>Get a focused assessment of what should be automated, connected, or built first.</p>
    </div>
    <div class="footer-conversion-action">
      <a class="button" href="/automation-assessment/?source=site-footer">Take the Free Assessment <span aria-hidden="true">↗</span></a>
      <p>Useful guidance first. No obligation.</p>
    </div>
  </div>

  <div class="container footer-shell">
    <div class="footer-brand">
      <div class="footer-brand-top">
        <img class="footer-brand-logo" src={logo} alt="" width="612" height="408" loading="lazy" decoding="async" />
        <p class="footer-title">{companyName}</p>
      </div>
      <p class="footer-description">{footer.blurb}</p>
      <address class="footer-contact-links" aria-label="Contact Velixon">
        <a href={`mailto:${footer.email}`}>{footer.email}</a>
        <a href={phoneHref}>{phone}</a>
      </address>
      <nav class="footer-socials" aria-label="Social links">
        {footer.socials.map((item) => (
          <a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.label}>
            {item.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="footer-navigation">
      {nav.map((group) => (
        <div class="footer-column">
          <p class="footer-heading">{group.heading}</p>
          <nav class="footer-nav" aria-label={group.ariaLabel}>
            {group.items.map((item) => <a href={item.href}>{item.label}</a>)}
          </nav>
        </div>
      ))}
    </div>
  </div>

  <div class="container footer-disclosure">
    <p>Website content, calculators, and estimates are general information—not legal, financial, compliance, or accounting advice—and do not guarantee project or business results.</p>
  </div>

  <div class="container footer-bottom">
    <p>© {currentYear} {companyName}. All rights reserved.</p>
    <nav class="footer-utility" aria-label="Footer utility navigation">
      <a href="/privacy/#choices">Privacy choices</a>
      {analyticsEnabled && <button class="footer-settings-button" type="button" data-consent-settings>Analytics preferences</button>}
    </nav>
  </div>
</footer>
