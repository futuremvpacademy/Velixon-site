---
interface Props {
  cta: {
    eyebrow: string;
    title: string;
    description: string;
    trustLine: string;
    primary: string;
    primaryHref: string;
    secondary: string;
    secondaryHref: string;
  };
}

const { cta } = Astro.props;
---

<section class="closing-cta-section">
  <div class="container">
    <div class="closing-cta-shell" data-motion-stagger>
      <p class="eyebrow" data-motion-reveal="fade">{cta.eyebrow}</p>
      <h2 data-motion-reveal="left">{cta.title}</h2>
      <p class="closing-cta-text" data-motion-reveal="fade">{cta.description}</p>
      <p class="closing-cta-trust" data-motion-reveal="fade">{cta.trustLine}</p>
      <div class="closing-cta-actions" data-motion-reveal="scale">
        <a class="button" href={cta.primaryHref} data-analytics-event={cta.primaryHref.startsWith("/free-audit") ? "free_audit_cta_clicked" : undefined} data-analytics-location="closing-cta">{cta.primary}</a>
        <a class="button button-secondary" href={cta.secondaryHref}>{cta.secondary}</a>
      </div>
    </div>
  </div>
</section>
