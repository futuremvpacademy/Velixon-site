---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  cta?: string;
  ctaHref?: string;
  secondaryCta?: string;
  secondaryCtaHref?: string;
  helper?: string;
}

const { eyebrow, title, description, cta, ctaHref, secondaryCta, secondaryCtaHref, helper } = Astro.props;
const analyticsEventForHref = (href?: string) => {
  if (href?.startsWith("/free-audit")) return "free_audit_cta_clicked";
  if (href?.startsWith("/estimate-request") || href === "#estimate-request-form") return "estimate_request_cta_clicked";
  return undefined;
};
---

<section class="page-hero">
  <div class="page-hero-orb page-hero-orb-one" aria-hidden="true"></div>
  <div class="page-hero-orb page-hero-orb-two" aria-hidden="true"></div>
  <div class="container page-hero-shell">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="page-hero-text">{description}</p>

    {(cta || secondaryCta) && (
      <div class="page-hero-actions">
        {cta && ctaHref && <a class="button" href={ctaHref} data-analytics-event={analyticsEventForHref(ctaHref)} data-analytics-location="page-hero">{cta}</a>}
        {secondaryCta && secondaryCtaHref && <a class="button button-secondary" href={secondaryCtaHref} data-analytics-event={analyticsEventForHref(secondaryCtaHref)} data-analytics-location="page-hero-secondary">{secondaryCta}</a>}
      </div>
    )}

    {helper && <p class="page-hero-helper">{helper}</p>}
  </div>
</section>
