<section class="vx-opportunity vx-section" id="automation-roi" aria-labelledby="automation-roi-title">
  <div class="container vx-opportunity-shell">
    <div class="vx-opportunity-copy" data-vx-reveal>
      <p class="vx-kicker">Automation opportunity calculator</p>
      <h2 id="automation-roi-title">Put a value on the work your team should not be doing manually.</h2>
      <p>
        Model one repetitive workflow using your own inputs. The estimate is a starting point for prioritization—not a promise, quote, or substitute for process discovery.
      </p>

      <div class="vx-opportunity-signals" aria-label="Strong automation opportunity signals">
        <article>
          <span>01</span>
          <div><h3>High repetition</h3><p>The same steps happen every day or every week.</p></div>
        </article>
        <article>
          <span>02</span>
          <div><h3>Multiple handoffs</h3><p>Work moves between people, inboxes, sheets, and software.</p></div>
        </article>
        <article>
          <span>03</span>
          <div><h3>Clear rules</h3><p>The next action can be defined, checked, or escalated.</p></div>
        </article>
      </div>
    </div>

    <form class="vx-calculator" data-opportunity-calculator aria-describedby="calculator-disclaimer">
      <div class="vx-calculator-topline">
        <div>
          <p>Illustrative model</p>
          <h3>One workflow, annualized</h3>
        </div>
        <span>Adjust the inputs</span>
      </div>

      <div class="vx-calculator-fields">
        <label for="workflow-hours">
          <span>Manual hours per person, each week</span>
          <output for="workflow-hours" data-hours-output>12 hours</output>
        </label>
        <input id="workflow-hours" name="workflow-hours" type="range" min="2" max="80" value="12" step="2" />

        <label for="team-size">
          <span>People involved in the workflow</span>
          <output for="team-size" data-team-output>4 people</output>
        </label>
        <input id="team-size" name="team-size" type="range" min="1" max="30" value="4" step="1" />

        <label for="loaded-cost">
          <span>Estimated hourly cost</span>
          <output for="loaded-cost" data-cost-output>$45 / hour</output>
        </label>
        <input id="loaded-cost" name="loaded-cost" type="range" min="20" max="200" value="45" step="5" />

        <label for="automation-share">
          <span>Work that may be responsibly automated</span>
          <output for="automation-share" data-share-output>40%</output>
        </label>
        <input id="automation-share" name="automation-share" type="range" min="10" max="80" value="40" step="5" />
      </div>

      <div class="vx-calculator-result" aria-live="polite" aria-atomic="true">
        <p>Illustrative annual opportunity</p>
        <div class="vx-calculator-metrics">
          <article>
            <strong data-hours-result>998</strong>
            <span>hours of team capacity</span>
          </article>
          <article>
            <strong data-value-result>$44,910</strong>
            <span>capacity value</span>
          </article>
          <article>
            <strong data-weeks-result>25</strong>
            <span>40-hour workweeks</span>
          </article>
        </div>
      </div>

      <p class="vx-calculator-disclaimer" id="calculator-disclaimer">
        This simple model excludes implementation cost, adoption, exceptions, quality gains, and revenue impact. A real assessment validates the workflow before estimating return.
      </p>
      <a class="vx-calculator-method-link" href="/resources/ai-automation-roi-calculator/">
        Run the full AI automation ROI calculator <span aria-hidden="true">→</span>
      </a>
      <a
        class="vx-calculator-cta"
        data-calculator-cta
        data-analytics-cta="free-audit"
        data-analytics-event="free_audit_cta_clicked"
        data-analytics-location="homepage-roi-calculator"
        href="/free-audit/#book-audit"
      >
        Request Your Free Audit <span aria-hidden="true">↗</span>
      </a>
    </form>
  </div>
</section>

<script>
  const calculators = document.querySelectorAll<HTMLFormElement>("[data-opportunity-calculator]");

  calculators.forEach((calculator) => {
    const hours = calculator.querySelector<HTMLInputElement>("#workflow-hours");
    const team = calculator.querySelector<HTMLInputElement>("#team-size");
    const cost = calculator.querySelector<HTMLInputElement>("#loaded-cost");
    const share = calculator.querySelector<HTMLInputElement>("#automation-share");
    const hoursOutput = calculator.querySelector<HTMLOutputElement>("[data-hours-output]");
    const teamOutput = calculator.querySelector<HTMLOutputElement>("[data-team-output]");
    const costOutput = calculator.querySelector<HTMLOutputElement>("[data-cost-output]");
    const shareOutput = calculator.querySelector<HTMLOutputElement>("[data-share-output]");
    const hoursResult = calculator.querySelector<HTMLElement>("[data-hours-result]");
    const valueResult = calculator.querySelector<HTMLElement>("[data-value-result]");
    const weeksResult = calculator.querySelector<HTMLElement>("[data-weeks-result]");
    const number = new Intl.NumberFormat("en-US", { maximumFractionDigits: 0 });
    const currency = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
    let trackedEngagement = false;

    if (!hours || !team || !cost || !share) return;

    const analytics = () => (window as Window & {
      velixonAnalytics?: { track: (name: string, parameters?: Record<string, unknown>) => void };
    }).velixonAnalytics;

    const update = () => {
      const weeklyHours = Number(hours.value);
      const people = Number(team.value);
      const hourlyCost = Number(cost.value);
      const automationShare = Number(share.value) / 100;
      const annualHours = Math.round(weeklyHours * people * 52 * automationShare);
      const annualValue = Math.round(annualHours * hourlyCost);
      const workweeks = Math.round(annualHours / 40);

      if (hoursOutput) hoursOutput.value = `${weeklyHours} hours`;
      if (teamOutput) teamOutput.value = `${people} ${people === 1 ? "person" : "people"}`;
      if (costOutput) costOutput.value = `${currency.format(hourlyCost)} / hour`;
      if (shareOutput) shareOutput.value = `${share.value}%`;
      if (hoursResult) hoursResult.textContent = number.format(annualHours);
      if (valueResult) valueResult.textContent = currency.format(annualValue);
      if (weeksResult) weeksResult.textContent = number.format(workweeks);
    };

    calculator.addEventListener("submit", (event) => event.preventDefault());

    calculator.addEventListener("input", () => {
      update();
      if (!trackedEngagement) {
        trackedEngagement = true;
        analytics()?.track("roi_calculator_engaged", { calculator_name: "automation-opportunity" });
      }
    });

    update();
  });
</script>

