---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "./Navbar.astro";
import { siteContent } from "../data/site";
import type { CaseStudyData } from "../data/seo/types";
import "../styles/seo-clusters.css";

interface Props { page: CaseStudyData; }
const { page } = Astro.props;
const { companyName, logo, nav, cta } = siteContent;
const url = `https://velixon.net/case-studies/${page.slug}/`;
const articleSchema = { "@type": "Article", "@id": `${url}#article`, headline: page.headline, description: page.metaDescription, url, author: { "@id": "https://velixon.net/#organization" }, publisher: { "@id": "https://velixon.net/#organization" }, datePublished: "2026-07-15", dateModified: "2026-07-15" };
---

<MainLayout
  title={page.metaTitle}
  description={page.metaDescription}
  ogType="article"
  publishedTime="2026-07-15"
  modifiedTime="2026-07-15"
  articleSection="Case Study"
  schema={[articleSchema]}
>
  <Navbar companyName={companyName} logo={logo} nav={nav} cta={cta} currentPath="/case-studies/" />
  <main id="main-content" class="cluster-page case-study-page">
    <header class="cluster-hero"><div class="cluster-grid" aria-hidden="true"></div><div class="container cluster-hero-shell"><nav class="cluster-breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/case-studies/">Case studies</a></li><li aria-current="page">{page.subject}</li></ol></nav><div class="cluster-hero-layout"><div><p class="cluster-eyebrow">{page.engagementType}</p><h1>{page.headline}</h1><p class="cluster-summary">{page.summary}</p><div class="cluster-actions"><a class="button" href="/contact/">Discuss a similar system</a><a class="button button-secondary" href="#solution">See the solution</a></div></div><aside class="cluster-answer"><span>{page.evidenceLabel}</span><h2>About this evidence</h2><p>{page.evidenceNote}</p></aside></div></div></header>
    <section class="cluster-section"><div class="container cluster-split"><div class="cluster-heading"><p class="cluster-eyebrow">The problem</p><h2>What the system needed to make possible</h2></div><ul class="case-study-problems">{page.problem.map((item) => <li>{item}</li>)}</ul></div></section>
    <section class="cluster-section cluster-section-light" id="solution"><div class="container"><div class="cluster-heading cluster-heading-wide"><p class="cluster-eyebrow">The solution</p><h2>One connected product, designed around the workflow</h2></div><div class="cluster-card-grid">{page.solution.map((item) => <article><i aria-hidden="true"></i><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></div></section>
    <section class="cluster-section"><div class="container cluster-split"><div class="cluster-heading cluster-sticky"><p class="cluster-eyebrow">Delivery</p><h2>How the system took shape</h2></div><ol class="cluster-process">{page.timeline.map((step) => <li><span>{step.label}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}</ol></div></section>
    <section class="cluster-section cluster-section-light"><div class="container"><div class="cluster-heading cluster-heading-wide"><p class="cluster-eyebrow">Business impact</p><h2>What the connected workflow changes</h2></div><div class="cluster-card-grid">{page.impact.map((item) => <article><i aria-hidden="true"></i><h3>{item.title}</h3><p>{item.description}</p></article>)}</div><p class="case-study-roi"><strong>ROI framework:</strong> {page.roiFramework}</p></div></section>
    <section class="cluster-section cluster-technology"><div class="container cluster-tech-layout"><div class="cluster-heading"><p class="cluster-eyebrow">Technology</p><h2>A maintainable production stack</h2></div><div class="cluster-tech-list">{page.technology.map((item) => <span>{item}</span>)}</div></div></section>
    <section class="cluster-section cluster-related"><div class="container"><div class="cluster-heading cluster-heading-wide"><p class="cluster-eyebrow">Related systems</p><h2>Explore connected capabilities</h2></div><div class="cluster-related-grid">{page.related.map((item) => <a href={item.href}><span>{item.label ?? "Related"}</span><h3>{item.title}</h3><p>{item.description}</p><b>Explore <i aria-hidden="true">→</i></b></a>)}</div></div></section>
    <section class="cluster-final"><div class="container"><p class="cluster-eyebrow">Build the next operating advantage</p><h2>Turn a fragmented workflow into one system.</h2><div class="cluster-actions"><a class="button" href="/contact/">Schedule a strategy call</a></div></div></section>
  </main>
</MainLayout>
