---
interface CardItem {
  id?: string;
  title: string;
  description: string;
  meta?: string;
  outcome?: string;
  href?: string;
  linkLabel?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  items: CardItem[];
}

const { eyebrow, title, description, items } = Astro.props;
---

<section class="page-section">
  <div class="container">
    <div class="section-intro" data-motion-reveal="left">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
      {description && <p>{description}</p>}
    </div>

    <div class="detail-grid" data-motion-stagger>
      {
        items.map((item) => (
          <article class="detail-card" id={item.id} data-motion-reveal="scale">
            {item.meta && <p class="detail-meta">{item.meta}</p>}
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            {item.outcome && <p class="detail-outcome">{item.outcome}</p>}
            {item.href && <a class="detail-link" href={item.href}>{item.linkLabel ?? `Explore ${item.title}`}<span aria-hidden="true"> →</span></a>}
          </article>
        ))
      }
    </div>
  </div>
</section>
