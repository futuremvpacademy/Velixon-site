---
const posterSource = "/images/velixon-audit-poster.webp";
const posterTransform = (width: number) => {
  const height = Math.round(width * 9 / 16);
  return `/.netlify/images?url=${encodeURIComponent(posterSource)}&w=${width}&h=${height}&fit=cover&fm=webp&q=86`;
};
const posterSrcset = [480, 720]
  .map((width) => `${posterTransform(width)} ${width}w`)
  .concat(`${posterSource} 960w`)
  .join(", ");
---

<figure class="audit-film" data-audit-film data-motion-reveal="right" data-motion-tilt data-motion-parallax>
  <div class="audit-film-frame">
    <video
      id="audit-overview-video"
      width="1280"
      height="720"
      playsinline
      preload="none"
      aria-label="Velixon Free Business Systems Audit overview"
      aria-describedby="audit-film-description"
      controlslist="nodownload noremoteplayback"
      disablepictureinpicture
    >
      <source src="/videos/velixon-audit-promo.mp4" type="video/mp4" />
    </video>

    <picture class="audit-film-poster" data-audit-film-poster aria-hidden="true">
      <img
        data-audit-film-poster-image
        src={posterSource}
        srcset={posterSrcset}
        sizes="(max-width: 900px) calc(100vw - 2rem), 50vw"
        alt=""
        width="960"
        height="540"
        decoding="async"
      />
    </picture>

    <button
      class="audit-film-play"
      type="button"
      aria-controls="audit-overview-video"
      data-audit-film-play
    >
      <span class="audit-film-play-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="M8.25 5.6v12.8L18 12 8.25 5.6Z" fill="currentColor"></path>
        </svg>
      </span>
      <span>Play the 18-second overview</span>
    </button>

    <a
      class="audit-film-fallback"
      href="/free-audit/#book-audit"
      data-analytics-event="free_audit_cta_clicked"
      data-analytics-location="homepage-video-fallback"
      data-audit-film-fallback
      hidden
    >Request Audit</a>
  </div>

  <figcaption class="audit-film-caption" id="audit-film-description">
    A silent, animated overview showing how Velixon reviews websites, leads, operations, revenue
    flow, software, and automation before recommending what to fix first.
  </figcaption>
</figure>

<script>
  type AnalyticsApi = {
    track: (name: string, parameters?: Record<string, unknown>) => void;
  };

  type AnalyticsWindow = Window & {
    velixonAnalytics?: AnalyticsApi;
  };

  const analytics = () => (window as AnalyticsWindow).velixonAnalytics;

  document.querySelectorAll<HTMLElement>("[data-audit-film]").forEach((film) => {
    const video = film.querySelector<HTMLVideoElement>("video");
    const poster = film.querySelector<HTMLElement>("[data-audit-film-poster]");
    const posterImage = film.querySelector<HTMLImageElement>("[data-audit-film-poster-image]");
    const playButton = film.querySelector<HTMLButtonElement>("[data-audit-film-play]");
    const fallback = film.querySelector<HTMLAnchorElement>("[data-audit-film-fallback]");
    if (!video || !playButton || !fallback) return;

    const eventDetails = {
      video_id: "audit_overview_18s",
      video_location: "homepage-hero",
      page_path: window.location.pathname
    };
    let viewed = false;
    let started = false;
    let completed = false;

    const loadPosterFallback = () => {
      if (!posterImage?.hasAttribute("srcset")) return;
      const fallbackSource = posterImage.getAttribute("src") || "";
      posterImage.removeAttribute("srcset");
      if (fallbackSource) posterImage.src = fallbackSource;
    };
    posterImage?.addEventListener("error", loadPosterFallback);
    if (posterImage?.complete && posterImage.naturalWidth === 0) loadPosterFallback();

    const trackOnce = (eventName: string) => {
      if (eventName === "audit_video_viewed") {
        if (viewed) return;
        viewed = true;
      } else if (eventName === "audit_video_started") {
        if (started) return;
        started = true;
      } else if (eventName === "audit_video_completed") {
        if (completed) return;
        completed = true;
      }
      analytics()?.track(eventName, eventDetails);
    };

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting && entry.intersectionRatio >= 0.5)) {
          trackOnce("audit_video_viewed");
          observer.disconnect();
        }
      }, { threshold: 0.5 });
      observer.observe(film);
    }

    playButton.addEventListener("click", async () => {
      playButton.disabled = true;
      video.controls = true;
      try {
        await video.play();
        playButton.hidden = true;
      } catch {
        video.controls = false;
        playButton.disabled = false;
      }
    });

    video.addEventListener("play", () => {
      trackOnce("audit_video_started");
      playButton.hidden = true;
    });

    video.addEventListener("playing", () => {
      poster?.setAttribute("hidden", "");
    });

    video.addEventListener("ended", () => {
      trackOnce("audit_video_completed");
    });

    video.addEventListener("error", () => {
      poster?.removeAttribute("hidden");
      playButton.hidden = true;
      fallback.hidden = false;
    });
  });
</script>

<style>
  .audit-film-poster {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: block;
    pointer-events: none;
  }

  .audit-film-poster[hidden] {
    display: none;
  }

  .audit-film-poster img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .audit-film-play,
  .audit-film-fallback {
    z-index: 2;
  }
</style>
