---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "./Navbar.astro";
import { siteContent } from "../data/site";
import type { DirectoryGroup } from "../data/seo/types";
import { buildDirectorySchema } from "../lib/directory-schema";
import "../styles/seo-clusters.css";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  headline: string;
  summary: string;
  path: string;
  groups: DirectoryGroup[];
  selectionTitle?: string;
  selectionGuidance?: string;
  primaryAction?: DirectoryAction;
  secondaryAction?: DirectoryAction;
  statusNotice?: DirectoryStatusNotice;
  pathways?: DirectoryPathways;
}

interface DirectoryAction {
  label: string;
  href: string;
}

interface DirectoryStatusNotice {
  eyebrow: string;
  title: string;
  description: string;
}

interface DirectoryPathway {
  title: string;
  description: string;
  href: string;
  label?: string;
  linkLabel: string;
}

interface DirectoryPathways {
  eyebrow?: string;
  title: string;
  description: string;
  items: DirectoryPathway[];
  actions?: DirectoryAction[];
}

const {
  title,
  description,
  eyebrow,
  headline,
  summary,
  path,
  groups,
  selectionTitle,
  selectionGuidance,
  primaryAction = { label: "Request Your Free Audit", href: "/free-audit/?source=directory-hub#book-audit" },
  secondaryAction = { label: "Explore capabilities", href: "#directory" },
  statusNotice,
  pathways
} = Astro.props;
const { companyName, logo, nav, cta } = siteContent;
const directorySchema = buildDirectorySchema({ title, description, headline, path, groups });
---

<MainLayout title={title} description={description} canonicalPath={path} schema={directorySchema}>
  <Navbar companyName={companyName} logo={logo} nav={nav} cta={cta} currentPath={path} />
  <main id="main-content" class="directory-page">
    <header class="directory-hero">
      <div class="cluster-grid" aria-hidden="true"></div>
      <div class="container" data-motion-stagger>
        <p class="cluster-eyebrow" data-motion-reveal="left">{eyebrow}</p>
        <h1 data-motion-reveal="left">{headline}</h1>
        <p data-motion-reveal="left">{summary}</p>
        <div class="cluster-actions" data-motion-reveal="fade">
          <a class="button" href={primaryAction.href} data-analytics-event={primaryAction.href.startsWith("/free-audit") ? "free_audit_cta_clicked" : undefined} data-analytics-location="directory-hero">{primaryAction.label}</a>
          <a class="button button-secondary" href={secondaryAction.href}>{secondaryAction.label}</a>
        </div>
      </div>
    </header>
    <div class="directory-groups" id="directory">
      {statusNotice && (
        <section class="directory-group" aria-labelledby="directory-status-title">
          <div class="container">
            <div class="cluster-answer" data-motion-reveal="scale">
              <span>{statusNotice.eyebrow}</span>
              <h2 id="directory-status-title">{statusNotice.title}</h2>
              <p>{statusNotice.description}</p>
            </div>
          </div>
        </section>
      )}
      {selectionGuidance && (
        <section class="directory-group" aria-labelledby="directory-selection-title">
          <div class="container">
            <div class="cluster-heading cluster-heading-wide" data-motion-reveal="left">
              <h2 id="directory-selection-title">{selectionTitle ?? "Choose the right starting point"}</h2>
              <p>{selectionGuidance}</p>
            </div>
          </div>
        </section>
      )}
      {groups.map((group) => (
        <section class="directory-group">
          <div class="container">
            <div class="cluster-heading cluster-heading-wide" data-motion-reveal="left">
              <h2>{group.title}</h2>
              <p>{group.description}</p>
            </div>
            <div class="directory-grid" data-motion-stagger>
              {group.items.map((item) => (
                <a href={item.href}><span>{item.label ?? "Capability"}</span><h3>{item.title}</h3><p>{item.description}</p><b>Explore <i aria-hidden="true">→</i></b></a>
              ))}
            </div>
          </div>
        </section>
      ))}
      {pathways && (
        <section class="directory-group" aria-labelledby="directory-pathways-title">
          <div class="container">
            <div class="cluster-heading cluster-heading-wide" data-motion-reveal="left">
              {pathways.eyebrow && <p class="cluster-eyebrow">{pathways.eyebrow}</p>}
              <h2 id="directory-pathways-title">{pathways.title}</h2>
              <p>{pathways.description}</p>
            </div>
            <div class="directory-grid" data-motion-stagger>
              {pathways.items.map((item) => (
                <a href={item.href}>
                  <span>{item.label ?? "Related capability"}</span>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                  <b>{item.linkLabel} <i aria-hidden="true">→</i></b>
                </a>
              ))}
            </div>
            {pathways.actions && pathways.actions.length > 0 && (
              <div class="cluster-actions">
                {pathways.actions.map((action, index) => (
                  <a class:list={["button", { "button-secondary": index > 0 }]} href={action.href} data-analytics-event={action.href.startsWith("/free-audit") ? "free_audit_cta_clicked" : undefined} data-analytics-location="directory-pathways">{action.label}</a>
                ))}
              </div>
            )}
          </div>
        </section>
      )}
    </div>
  </main>
</MainLayout>
