---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import AuditPromoVideo from "../components/AuditPromoVideo.astro";
import FreeAuditFeature from "../components/FreeAuditFeature.astro";
import ReviewWheel from "../components/ReviewWheel.astro";
import { siteContent } from "../data/site";
import "../styles/home.css";

const { companyName, logo, nav, cta } = siteContent;

const auditAreas = [
  ["01", "Website", "Message, trust, mobile experience, and conversion paths."],
  ["02", "Leads", "Capture, response time, ownership, and follow-up."],
  ["03", "Operations", "Scheduling, handoffs, consistency, and admin work."],
  ["04", "Revenue flow", "Proposals, approvals, invoicing, and payments."],
  ["05", "Software", "Disconnected tools, duplicate work, data, and automation."]
];

const capabilities = [
  {
    number: "01",
    title: "Lead paths that respond and convert",
    description: "Clear websites, faster intake, reliable routing, and follow-up that reaches the right person.",
    href: "/services/",
    linkLabel: "Improve the lead system"
  },
  {
    number: "02",
    title: "Workflows that move on their own",
    description: "Connected lead, scheduling, document, payment, and follow-up systems—with human control where it matters.",
    href: "/services/workflow-automation/",
    linkLabel: "Explore workflow automation"
  },
  {
    number: "03",
    title: "Software that fits the business",
    description: "Custom portals, dashboards, CRMs, internal tools, and AI systems shaped around the way your team works.",
    href: "/services/custom-software/",
    linkLabel: "Explore custom software"
  }
];

const products = [
  {
    label: "FormEsque",
    title: "One connected path from proposal to payment.",
    description: "A Velixon-built product connecting proposals, signatures, invoicing, customer records, and workflow.",
    href: "/case-studies/formesque-proposal-to-payment-platform/"
  },
  {
    label: "ShareCal",
    title: "Shared time without the scheduling confusion.",
    description: "A collaborative calendar designed to make availability, events, and group coordination easier to understand.",
    href: "/case-studies/sharecal-collaborative-scheduling-platform/"
  }
];

const process = [
  ["01", "Audit", "Find the friction across the customer journey and operation."],
  ["02", "Prioritize", "Choose the fix with the clearest business value and lowest avoidable risk."],
  ["03", "Build", "Design, launch, and improve the system around real use."]
];

const faqs = [
  {
    question: "What does Velixon build?",
    answer: "Velixon builds conversion-focused websites, workflow automation, AI systems, custom software, CRMs, portals, dashboards, and the integrations that connect them."
  },
  {
    question: "What happens in the free audit?",
    answer: "Velixon reviews the information you provide and relevant public website information, then sends a personalized one-page scorecard with three prioritized recommendations within three business days."
  },
  {
    question: "Do I have to buy anything after the audit?",
    answer: "No. The audit is free and there is no obligation to purchase implementation. After delivery, you may reply to the audit email to request an optional 20-minute strategy call, which Velixon arranges manually."
  },
  {
    question: "Who is Velixon best suited to help?",
    answer: "Velixon is especially useful for growing service businesses losing time, leads, or money through manual work, disconnected tools, slow follow-up, or systems that no longer fit."
  }
];

const homeSchema = [
  {
    "@type": "ItemList",
    name: "Velixon business system capabilities",
    itemListElement: capabilities.map((capability, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Service",
        name: capability.title,
        description: capability.description,
        provider: { "@id": "https://velixon.net/#organization" },
        url: new URL(capability.href, "https://velixon.net").toString()
      }
    }))
  },
  {
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer }
    }))
  },
  {
    "@type": "VideoObject",
    name: "Velixon Free Business Systems Audit Overview",
    description: "An 18-second overview of how Velixon finds friction across leads, operations, and software before recommending what to fix first.",
    thumbnailUrl: "https://velixon.net/images/velixon-audit-poster.webp",
    uploadDate: "2026-07-20T00:00:00-06:00",
    duration: "PT18S",
    contentUrl: "https://velixon.net/videos/velixon-audit-promo.mp4"
  }
];
---

<MainLayout
  title="Custom Software, AI & Automation for Business | Velixon"
  description="Velixon finds friction across your website, leads, operations, and software—then builds the connected systems that fix it."
  schema={homeSchema}
>
  <Navbar companyName={companyName} logo={logo} nav={nav} cta={cta} currentPath="/" />

  <main class="home-clean" id="main-content">
    <section class="home-hero" data-motion-hero>
      <div class="home-hero-glow" aria-hidden="true"></div>
      <div class="container home-hero-layout">
        <div class="home-hero-copy" data-motion-reveal="left">
          <p class="home-eyebrow">Systems for growing service businesses</p>
          <h1>Fix the systems costing you <em>time, leads, and money.</em></h1>
          <p class="home-hero-lead">Velixon helps service businesses connect the path from first inquiry to finished work—starting with a clear audit of the website, lead flow, operations, and software.</p>
          <div class="home-actions">
            <a
              class="button home-primary"
              href={cta.href}
              data-analytics-cta="free-audit"
              data-analytics-event={cta.analyticsEvent}
              data-analytics-location="homepage-hero"
            >{cta.label} <span aria-hidden="true">↗</span></a>
            <a
              class="button button-secondary"
              href="/estimate-request/?source=homepage-hero&campaign=estimate#estimate-request-form"
              data-analytics-event="estimate_request_cta_clicked"
              data-analytics-location="homepage-hero"
            >Get a Project Estimate <span aria-hidden="true">↗</span></a>
          </div>
          <ul class="home-trust" aria-label="Ways to start with Velixon">
            <li>Audit an existing system</li>
            <li>Estimate a defined project</li>
            <li>Utah-based · Serving U.S. businesses</li>
          </ul>
        </div>

        <AuditPromoVideo />
      </div>

      <div class="container home-area-strip" aria-label="Five areas reviewed in the free audit" data-motion-stagger>
        {auditAreas.map(([number, title, description]) => (
          <div><span>{number}</span><strong>{title}</strong><small>{description}</small></div>
        ))}
      </div>
    </section>

    <FreeAuditFeature />

    <ReviewWheel />

    <section class="home-section home-capabilities" aria-labelledby="home-capabilities-title">
      <div class="container">
        <div class="home-section-heading" data-motion-reveal>
          <div><p class="home-eyebrow">What Velixon fixes</p><h2 id="home-capabilities-title">A cleaner path from lead to payment.</h2></div>
          <p>Start with the broken handoff. Build only what makes the service easier to buy, deliver, and manage.</p>
        </div>
        <div class="home-capability-grid" data-motion-stagger>
          {capabilities.map((capability) => (
            <article data-motion-tilt>
              <span>{capability.number}</span>
              <h3>{capability.title}</h3>
              <p>{capability.description}</p>
              <a href={capability.href}>{capability.linkLabel} <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
        <p class="home-resource-route">Planning an automation investment? <a href="/resources/ai-automation-roi-calculator/">Estimate the opportunity with the free ROI calculator <span aria-hidden="true">↗</span></a></p>
      </div>
    </section>

    <section class="home-section home-products" id="products" aria-labelledby="home-products-title">
      <div class="container">
        <div class="home-section-heading" data-motion-reveal>
          <div><p class="home-eyebrow">First-party product proof</p><h2 id="home-products-title">Inspect the systems behind the claims.</h2></div>
          <p>FormEsque and our collaborative calendar product show how Velixon turns operational problems into focused, connected software without inventing client outcomes.</p>
        </div>
        <div class="home-product-grid" data-motion-stagger>
          {products.map((product, index) => (
            <article class:list={["home-product-card", { "home-product-alt": index === 1 }]} data-motion-tilt>
              <div class="home-product-mark" aria-hidden="true">{product.label.slice(0, 1)}</div>
              <p>{product.label}</p>
              <h3>{product.title}</h3>
              <span>{product.description}</span>
              <a href={product.href}>Read the product case study <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="home-section home-process" aria-labelledby="home-process-title">
      <div class="container home-process-layout">
        <div class="home-process-intro" data-motion-reveal="left">
          <p class="home-eyebrow">How it works</p>
          <h2 id="home-process-title">Audit. Prioritize. Improve.</h2>
          <p>No software prescription before the operating problem and expected outcome are clear.</p>
          <a href="/process/">See the full process <span aria-hidden="true">↗</span></a>
        </div>
        <ol class="home-process-list" data-motion-path>
          {process.map(([number, title, description]) => (
            <li><span>{number}</span><div><h3>{title}</h3><p>{description}</p></div></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="home-section home-faq" aria-labelledby="home-faq-title">
      <div class="container home-faq-layout">
        <div data-motion-reveal="left">
          <p class="home-eyebrow">Straight answers</p>
          <h2 id="home-faq-title">Know what you are starting.</h2>
          <button class="home-text-button" type="button" data-inquiry-open>Still have a question? Ask Velixon <span aria-hidden="true">↗</span></button>
        </div>
        <div class="home-faq-list" data-motion-stagger>
          {faqs.map((faq, index) => (
            <details open={index === 0}>
              <summary>{faq.question}<span aria-hidden="true">+</span></summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
</MainLayout>
