---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import PageHero from "../components/PageHero.astro";
import CardSection from "../components/CardSection.astro";
import FinalCtaSection from "../components/FinalCtaSection.astro";
import { siteContent } from "../data/site";
const { companyName, logo, nav, cta } = siteContent;
const outcomes = [
  { title: "One source of truth", description: "Customer, operational, and financial data stays current across the business." },
  { title: "Fewer broken handoffs", description: "Each stage moves into the next without duplicate entry or lost context." },
  { title: "Faster customer response", description: "AI and automation handle defined work while people stay in control of important decisions." },
  { title: "A long-term business asset", description: "The system improves with the company instead of becoming another limitation to work around." }
];
const auditHref = "/free-audit/?source=results-page#book-audit";
const finalCta = { eyebrow: "Operational leverage", title: "Replace fragmented work with one connected operating flow.", description: "The result is not more software. It is a business that can respond, deliver, and improve with less friction.", points: ["Connected data", "Clear workflows", "Software that evolves"], primary: "Request Your Free Audit", primaryHref: auditHref, secondary: "Get a Project Estimate", secondaryHref: "/estimate-request/?source=results-page&campaign=estimate#estimate-request-form", helper: "Receive a one-page scorecard and three priorities within three business days." };
---
<MainLayout title="Business Outcomes from Connected Software | Velixon" description="Learn how connected software can centralize data, reduce broken handoffs, improve response, and become a long-term business asset."><Navbar companyName={companyName} logo={logo} nav={nav} cta={cta} currentPath="/results" /><main id="main-content"><PageHero eyebrow="Business outcomes" title="What changes when the business operates as one system." description="Velixon replaces disconnected tools and manual handoffs with systems designed to keep customers, work, money, and data moving together." cta="Request Your Free Audit" ctaHref={auditHref} helper="Start by identifying the systems and handoffs creating the most friction." /><CardSection eyebrow="What changes" title="From operational drag to operational leverage" description="Every system is different. These are the durable outcomes connected business software is designed to support." items={outcomes} /><FinalCtaSection cta={finalCta} /></main></MainLayout>
