---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import PageHero from "../components/PageHero.astro";
import CardSection from "../components/CardSection.astro";
import FinalCtaSection from "../components/FinalCtaSection.astro";
import { siteContent } from "../data/site";
const { companyName, logo, nav, cta } = siteContent;
const stages = [
  { title: "01 · Discover", description: "We map the business, users, bottlenecks, data, and outcomes the system must support." },
  { title: "02 · Architect", description: "We define workflows, integrations, permissions, security, and the technical foundation before development." },
  { title: "03 · Build", description: "We design and engineer the system in focused releases with clear review points." },
  { title: "04 · Launch", description: "We migrate, test, train, and put the software into real production operation." },
  { title: "05 · Improve", description: "We measure what works, refine workflows, and expand the system as the business evolves." }
];
const auditHref = "/free-audit/?source=process-page#book-audit";
const finalCta = { eyebrow: "Start with clarity", title: "A reliable system begins with a clear understanding of the operation.", description: "Use the free systems audit for an existing or unclear problem. Request an estimate when the project is already defined.", points: ["Operational clarity", "Technical architecture", "A practical next step"], primary: "Request Your Free Audit", primaryHref: auditHref, secondary: "Get a Project Estimate", secondaryHref: "/estimate-request/?source=process-page&campaign=estimate#estimate-request-form", helper: "You do not need a finished specification to request the audit." };
---
<MainLayout title="Custom Software Development Process | Velixon" description="See how Velixon discovers, architects, builds, launches, measures, and improves production-ready custom software and AI systems."><Navbar companyName={companyName} logo={logo} nav={nav} cta={cta} currentPath="/process" /><main id="main-content"><PageHero eyebrow="How Velixon works" title="From operating problem to production software." description="Velixon studies the operation, architects the right system, builds it, launches it, and keeps improving it as the business changes." cta="Request Your Free Audit" ctaHref={auditHref} helper="Begin with the operating evidence before choosing what to build." /><CardSection eyebrow="Five stages" title="Discover, architect, build, launch, improve" description="Each stage reduces uncertainty and moves the system toward real business use." items={stages} /><FinalCtaSection cta={finalCta} /></main></MainLayout>
