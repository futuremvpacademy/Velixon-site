---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import PageHero from "../components/PageHero.astro";
import CardSection from "../components/CardSection.astro";
import FinalCtaSection from "../components/FinalCtaSection.astro";
import { siteContent } from "../data/site";
import { buildDirectorySchema } from "../lib/directory-schema";
import { automationServiceDirectory } from "../data/seo/service-landings";
import "../styles/seo-clusters.css";
const { companyName, logo, nav, cta } = siteContent;
const systems = [
  { id: "business-infrastructure", title: "Lead-to-payment systems", description: "Connect intake, routing, scheduling, proposals, approvals, invoicing, payments, and follow-up into one reliable operating flow.", meta: "Core service-business system", outcome: "Outcome: fewer dropped handoffs", href: "/services/business-infrastructure/", linkLabel: "Explore business infrastructure" },
  { id: "workflow-automation", title: "Workflow automation", description: "Reduce repetitive work with dependable routing, notifications, synchronization, and human approval where it matters.", meta: "Operational improvement", outcome: "Outcome: less admin and clearer ownership", href: "/services/workflow-automation/", linkLabel: "Explore workflow automation" },
  { id: "ai-automation", title: "Practical AI systems", description: "Apply AI to reception, sales, support, voice, and internal workflows using defined data, rules, and escalation paths.", meta: "Applied AI", outcome: "Outcome: faster response with human control", href: "/services/ai-automation/", linkLabel: "Explore AI automation" },
  { id: "custom-applications", title: "Software that fits the operation", description: "Build portals, dashboards, CRMs, internal tools, and customer-facing products when generic software creates the constraint.", meta: "Custom software", outcome: "Outcome: one system built around the business", href: "/services/custom-software/", linkLabel: "Explore custom software" }
];
const fit = [
  { title: "Leads wait or disappear", description: "Inquiries are copied, routed manually, answered late, or lost between the website and the person responsible." },
  { title: "Delivery depends on admin work", description: "Scheduling, updates, approvals, documents, and follow-up require repeated manual effort.", href: "/case-studies/", linkLabel: "Review source-backed product evidence" },
  { title: "Tools no longer fit", description: "The business has outgrown spreadsheets or generic software and needs a clearer connected workflow." }
];
const auditHref = "/free-audit/?source=services-page#book-audit";
const finalCta = { eyebrow: "Choose the right starting point", title: "Start with the problem—not a list of features.", description: "Use the free systems audit when the right priority is unclear. Request an estimate when the project is already defined.", points: ["One-page audit scorecard", "Projects starting at $200", "Remote delivery across the U.S."], primary: "Request Your Free Audit", primaryHref: auditHref, secondary: "Get a Project Estimate", secondaryHref: "/estimate-request/?source=services-page&campaign=estimate#estimate-request-form", helper: "Project Estimate responses arrive within 1 business day; audit delivery takes 3 business days." };
const servicesSchema = systems.map((service) => ({
  "@type": "Service",
  name: service.title,
  description: service.description,
  url: new URL(service.href ?? `/services/#${service.id}`, "https://velixon.net").toString(),
  provider: { "@id": "https://velixon.net/#organization" },
  areaServed: "United States"
}));
const serviceDirectorySchema = buildDirectorySchema({
  title: "Business Systems, Automation & Custom Software | Velixon",
  description: "Explore Velixon's lead-to-payment systems, workflow automation, applied AI, and custom software for growing service businesses.",
  headline: "Connected systems for growing service businesses.",
  path: "/services/",
  groups: [{
    title: "From application to infrastructure",
    description: "Automation is one layer. The goal is a reliable operating system that reduces work across the entire business.",
    items: systems.map((service) => ({
      title: service.title,
      description: service.description,
      href: service.href,
      label: service.meta
    }))
  }]
});
---
<MainLayout title="Business Systems, Automation & Custom Software | Velixon" description="Velixon helps growing service businesses improve lead flow, operations, workflow automation, AI, and custom software." canonicalPath="/services/" schema={[serviceDirectorySchema, servicesSchema]}>
  <Navbar companyName={companyName} logo={logo} nav={nav} cta={cta} currentPath="/services" />
  <main id="main-content">
    <PageHero eyebrow="Services for growing businesses" title="Move leads, work, and revenue through one clearer system." description="Velixon improves the connected path from inquiry and scheduling through delivery, follow-up, invoicing, and payment—then adds AI or custom software only where it helps." cta="Request Your Free Audit" ctaHref={auditHref} secondaryCta="Browse specialized services" secondaryCtaHref="#specialized-services" helper="Based in Utah · Serving businesses throughout the United States remotely" />
    <CardSection eyebrow="Core capabilities" title="Fix the handoff before adding another tool" description="Begin with the workflow that is losing the most time, leads, or money. Broader technical capabilities remain available when the problem requires them." items={systems} />

    <section class="directory-groups" id="specialized-services" aria-labelledby="specialized-services-title">
      <div class="directory-group">
        <div class="container">
          <div class="cluster-heading cluster-heading-wide">
            <p class="cluster-eyebrow">Complete service directory</p>
            <h2 id="specialized-services-title">Browse the technical capabilities behind the core systems.</h2>
            <p>These services support the larger business outcome. Start with the narrowest service that can fix the failing handoff, and expand the boundary only when the problem crosses teams or systems.</p>
          </div>
        </div>
      </div>
      {automationServiceDirectory.map((group) => (
        <section class="directory-group" aria-labelledby={`service-group-${group.title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}>
          <div class="container">
            <div class="cluster-heading cluster-heading-wide">
              <h2 id={`service-group-${group.title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}>{group.title}</h2>
              <p>{group.description}</p>
            </div>
            <div class="directory-grid">
              {group.items.map((item) => (
                <a href={item.href}>
                  <span>{item.label ?? "Service"}</span>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                  <b>Explore service <i aria-hidden="true">→</i></b>
                </a>
              ))}
            </div>
          </div>
        </section>
      ))}
    </section>

    <CardSection eyebrow="When improvement is worth exploring" title="Built for service businesses that have outgrown workarounds" description="The strongest projects begin with an operational constraint worth solving." items={fit} />
    <FinalCtaSection cta={finalCta} />
  </main>
</MainLayout>
