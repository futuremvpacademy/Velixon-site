---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import InquiryForm from "../components/InquiryForm.astro";
import { siteContent } from "../data/site";
import "../styles/contact-clean.css";

const { companyName, logo, nav, cta, contactInfo, businessInfo } = siteContent;
const phoneHref = `tel:${contactInfo.phone.replace(/[^0-9+]/g, "")}`;
---

<MainLayout
  title="Contact Velixon | Custom Software & AI Automation"
  description="Tell Velixon what should work better across your website, leads, workflows, software, or connected business systems, and get a clear next step."
>
  <Navbar companyName={companyName} logo={logo} nav={nav} cta={cta} currentPath="/contact" />
  <main id="main-content" class="contact-clean">
    <section class="contact-clean-hero">
      <div class="contact-clean-glow" aria-hidden="true"></div>
      <div class="container contact-clean-layout">
        <div class="contact-clean-copy">
          <p class="contact-clean-eyebrow">Questions and support</p>
          <h1>Ask a question or <em>send a quick note.</em></h1>
          <p>Use this page for a general question, support need, partnership note, or anything that does not require a full project brief.</p>
          <p><strong>{businessInfo.legalName}</strong> is {businessInfo.entityDescription}, founded by {businessInfo.founder}. Mailing address: {businessInfo.mailingAddress.formatted}.</p>
          <div class="contact-clean-direct" aria-label="Direct contact options">
            <a href={`mailto:${contactInfo.email}`}><span>Email</span><strong>{contactInfo.email}</strong></a>
            <a href={phoneHref}><span>Phone</span><strong>{contactInfo.phone}</strong></a>
          </div>
          <div class="contact-clean-audit">
            <span>Starting a project?</span>
            <a href="/free-audit/?source=contact-page#book-audit" data-analytics-event="free_audit_cta_clicked" data-analytics-location="contact-page">Existing or unclear: Free Business Systems Audit <span aria-hidden="true">↗</span></a>
            <a class="contact-clean-proposal" href="/estimate-request/?source=contact-page#estimate-request-form" data-analytics-event="estimate_request_cta_clicked" data-analytics-location="contact-page">Defined or new: Project Estimate <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <div class="contact-clean-form">
          <InquiryForm
            id="contact-form"
            formLocation="contact_page"
            heading="Send your message."
            description="A sentence or two is enough. We’ll reply within 1 business day."
          />
        </div>
      </div>
    </section>

    <section class="contact-clean-next" aria-labelledby="contact-next-title">
      <div class="container">
        <div class="contact-clean-next-heading">
          <p class="contact-clean-eyebrow">What happens next</p>
          <h2 id="contact-next-title">A direct response without a project intake form.</h2>
        </div>
        <ol>
          <li><span>01</span><div><h3>We read the message</h3><p>We review the question or context you chose to share.</p></div></li>
          <li><span>02</span><div><h3>You get a direct reply</h3><p>Within 1 business day, we answer, ask one useful follow-up, or point you to the right resource.</p></div></li>
          <li><span>03</span><div><h3>Projects use one clear lane</h3><p>If project intake is the right next step, we direct you to either the audit or Project Estimate.</p></div></li>
        </ol>
      </div>
    </section>
  </main>
</MainLayout>
