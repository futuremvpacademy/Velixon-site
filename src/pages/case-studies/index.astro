---
import DirectoryHub from "../../components/DirectoryHub.astro";
import { caseStudies } from "../../data/seo/case-studies";

const clientStudies = caseStudies.filter((page) => page.caseStudyType === "client");
const productStudies = caseStudies.filter((page) => page.caseStudyType === "product");
const groups = [
  {
    title: "External client work",
    description: "Authorized engagement facts and observable delivery evidence, published without invented performance metrics.",
    items: clientStudies.map((page) => ({ title: page.subject, description: page.summary, href: `/case-studies/${page.slug}/`, label: page.engagementType }))
  },
  {
    title: "Products designed and built by Velixon",
    description: "First-party product evidence focused on the operating problem, architecture, delivery decisions, and intended business value.",
    items: productStudies.map((page) => ({ title: page.subject, description: page.summary, href: `/case-studies/${page.slug}/`, label: page.engagementType }))
  }
];
---

<DirectoryHub
  title="Business Systems & Software Case Studies | Velixon"
  description="Explore authorized Frontier Fence client work alongside clearly labeled first-party Velixon product case studies for FormEsque and ShareCal."
  eyebrow="Case study evidence"
  headline="See how operating problems become working systems."
  summary="External client work and Velixon-owned products are labeled separately, with source-backed media and no fabricated performance claims."
  path="/case-studies/"
  groups={groups}
  primaryAction={{ label: "Request Your Free Audit", href: "/free-audit/?source=case-studies-hub#book-audit" }}
  secondaryAction={{ label: "Browse the case studies", href: "#directory" }}
  statusNotice={{
    eyebrow: "Evidence boundaries",
    title: "Client work and Velixon-owned product work are labeled separately.",
    description: "The Frontier Fence study uses authorized engagement facts and features visible on the live client site. The FormEsque and ShareCal studies document Velixon-owned products. None of the studies invent client metrics or imply evidence beyond the material shown."
  }}
  selectionTitle="Choose the evidence closest to your system"
  selectionGuidance="Start with Frontier Fence for an external website and business-infrastructure engagement. Use FormEsque for connected commercial operations or ShareCal for collaborative scheduling and shared-state product design."
  pathways={{
    eyebrow: "Related services",
    title: "Explore the capabilities behind these systems",
    description: "Use the service pages to evaluate the kind of system Velixon can plan and build, or start a conversation about the workflow your business needs to improve.",
    items: [
      {
        label: "Service",
        title: "AI Automation",
        description: "Design AI agents and governed automation around a defined business workflow, its data, and the people responsible for the outcome.",
        href: "/services/ai-automation/",
        linkLabel: "Explore AI automation services"
      },
      {
        label: "Service",
        title: "Custom Software Development",
        description: "Build an application, portal, dashboard, or internal system around the way your business actually operates.",
        href: "/services/custom-software/",
        linkLabel: "Explore custom software development"
      },
      {
        label: "Service",
        title: "Workflow Automation",
        description: "Connect tools, data, decisions, and handoffs so routine work moves reliably without losing human oversight.",
        href: "/services/workflow-automation/",
        linkLabel: "Explore workflow automation"
      }
    ],
    actions: [
      { label: "Request Your Free Audit", href: "/free-audit/?source=case-studies-pathways#book-audit" },
      { label: "Explore all services", href: "/services/" }
    ]
  }}
/>
