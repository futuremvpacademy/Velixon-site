---
import ClusterLanding from "../../components/ClusterLanding.astro";
import { integrationLandingPages } from "../../data/seo/integration-landings";

export function getStaticPaths() {
  return integrationLandingPages.map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}

const { page } = Astro.props;
---

<ClusterLanding page={page} />
