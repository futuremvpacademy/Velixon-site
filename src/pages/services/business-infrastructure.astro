const faqs = [
  {
    question: "What does business infrastructure mean in software?",
    answer: "Business infrastructure is the connected foundation behind customer, sales, scheduling, service, document, billing, payment, reporting, and administrative workflows. It includes systems of record, data models, permissions, integrations, lifecycle rules, and the custom software needed to make the operation work as one."
