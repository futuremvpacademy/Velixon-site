---
import ClusterLanding from "../../components/ClusterLanding.astro";
import { locationLandingPages } from "../../data/seo/location-landings";

export function getStaticPaths() {
  return locationLandingPages.map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}

const { page } = Astro.props;
---

<ClusterLanding page={page} />
