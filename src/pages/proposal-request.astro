---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import PageHero from "../components/PageHero.astro";
import { siteContent } from "../data/site";

const { companyName, logo, nav, cta } = siteContent;
const estimateHref = "/estimate-request/?source=proposal-transition#estimate-request-form";
---

<MainLayout
  title="Project Estimates | Velixon"
  description="Defined and new Velixon projects now use one Project Estimate request path."
  noIndex={true}
>
  <Navbar companyName={companyName} logo={logo} nav={nav} cta={cta} currentPath="/proposal-request" />
  <main id="main-content">
    <PageHero
      eyebrow="Project Estimate"
      title="Proposal requests now begin with a Project Estimate."
      description="Velixon uses one project-intake path for defined and new builds. Share the intended outcome, scope, budget, and timeline there, and we will reply with questions, a recommended first step, or an estimate when the scope is clear enough."
      cta="Open the Project Estimate"
      ctaHref={estimateHref}
      secondaryCta="Request Your Free Audit"
      secondaryCtaHref="/free-audit/?source=proposal-transition#book-audit"
      helper="Existing or unclear problem? Choose the Free Business Systems Audit. Defined or new project? Choose the Project Estimate."
    />
  </main>
</MainLayout>
