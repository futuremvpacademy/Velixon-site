---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import { siteContent } from "../data/site";
import { automationQuiz } from "../data/automation-quiz";
import "../styles/automation-quiz.css";

const { companyName, logo, nav, cta } = siteContent;
const quizSchema = {
  "@type": "WebApplication",
  name: "Velixon Business Automation Score Quiz",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description: "A free ten-question business automation quiz with an immediate maturity score, category breakdown, and practical recommendations.",
  url: "https://velixon.net/automation-assessment/",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" }
};
---

<MainLayout
  title="What's Your Business Automation Score? | Velixon"
  description="Answer ten practical questions to see your business automation maturity score, category breakdown, top weaknesses, and recommended next steps."
  imageAlt="Velixon business automation score quiz"
  schema={quizSchema}
>
  <Navbar companyName={companyName} logo={logo} nav={nav} cta={cta} currentPath="/automation-assessment" />
  <main id="main-content" class="automation-quiz-page">
    <section class="quiz-hero">
      <div class="container quiz-hero-grid">
        <div>
          <p class="quiz-eyebrow">Free ten-question self-assessment</p>
          <h1>What’s your business automation score?</h1>
          <p class="quiz-hero-copy">See how well your lead handling, follow-up, operations, documents, payments, reporting, and software work together. You’ll receive an immediate score and practical next steps.</p>
          <div class="quiz-hero-actions">
            <a class="button" href="#automation-score-quiz">Start the Quiz <span aria-hidden="true">↓</span></a>
            <span>No contact details required.</span>
          </div>
        </div>
        <aside class="quiz-overview" aria-label="What you will receive">
          <p>In about three minutes</p>
          <ul>
            <li>A score from 0–100</li>
            <li>Your automation maturity level</li>
            <li>A five-category breakdown</li>
            <li>Your top three weaknesses</li>
            <li>Practical recommendations</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="quiz-shell" id="automation-score-quiz" aria-labelledby="quiz-shell-heading">
      <div class="container">
        <h2 class="quiz-sr-only" id="quiz-shell-heading">Business automation score quiz</h2>
        <div class="quiz-card">
          <form id="business-automation-quiz" autocomplete="off">
            <div class="quiz-progress">
              <div class="quiz-progress-row">
                <span>Business automation score</span>
                <strong aria-live="polite" aria-atomic="true">Question <span data-current-question>1</span> of {automationQuiz.questions.length}</strong>
              </div>
              <progress data-quiz-progress max={automationQuiz.questions.length} value="1">1 of {automationQuiz.questions.length}</progress>
            </div>

            {automationQuiz.questions.map((question, index) => (
              <section
                class="quiz-step"
                data-question-step
                data-question-id={question.id}
                hidden={index !== 0}
                aria-labelledby={`quiz-question-${question.id}`}
              >
                <div class="quiz-step-heading">
                  <span>{String(index + 1).padStart(2, "0")} · {automationQuiz.categories.find((category) => category.id === question.categoryId)?.shortLabel}</span>
                  <h2 id={`quiz-question-${question.id}`} tabindex="-1">{question.prompt}</h2>
                  <p>{question.context}</p>
                </div>
                <fieldset class="quiz-options" aria-labelledby={`quiz-question-${question.id}`}>
                  <legend class="quiz-sr-only">Choose one answer</legend>
                  {question.options.map((option) => (
                    <label class="quiz-option" for={`${question.id}-${option.id}`}>
                      <input
                        id={`${question.id}-${option.id}`}
                        type="radio"
                        name={question.id}
                        value={option.id}
                        required
                      />
                      <span>{option.label}</span>
                    </label>
                  ))}
                </fieldset>
              </section>
            ))}

            <p class="quiz-error" id="quiz-error" role="alert" tabindex="-1" hidden></p>
            <div class="quiz-actions">
              <button class="quiz-back" type="button" data-quiz-back hidden>← Back</button>
              <button class="button" type="button" data-quiz-next>Continue</button>
              <button class="button" type="submit" data-quiz-submit hidden>See My Automation Score</button>
            </div>
            <noscript><p class="quiz-error">JavaScript is required to calculate this interactive score. You can still request a personalized audit from the Free Audit page.</p></noscript>
          </form>

          <section class="quiz-result" id="quiz-result" aria-live="polite" tabindex="-1" hidden>
            <div class="quiz-result-header">
              <div class="quiz-score" aria-label="Automation score">
                <strong data-result-score>0</strong>
                <span>out of 100</span>
              </div>
              <div>
                <p class="quiz-eyebrow" data-result-level>Assessment complete</p>
                <h2 data-result-title>Your automation score is ready.</h2>
                <p data-result-summary></p>
              </div>
            </div>

            <section class="quiz-result-section" aria-labelledby="category-results-heading">
              <div class="quiz-result-section-heading">
                <p class="quiz-eyebrow">Category breakdown</p>
                <h3 id="category-results-heading">Where your systems are strongest—and where they need attention</h3>
              </div>
              <div class="quiz-category-results" data-category-results></div>
            </section>

            <div class="quiz-result-columns">
              <section class="quiz-result-section" aria-labelledby="weaknesses-heading">
                <p class="quiz-eyebrow">Top weaknesses</p>
                <h3 id="weaknesses-heading">The first areas to examine</h3>
                <ol class="quiz-weaknesses" data-result-weaknesses></ol>
              </section>
              <section class="quiz-result-section" aria-labelledby="recommendations-heading">
                <p class="quiz-eyebrow">Recommendations</p>
                <h3 id="recommendations-heading">Practical next steps</h3>
                <ul class="quiz-recommendations" data-result-recommendations></ul>
              </section>
            </div>

            <section class="quiz-audit-cta" aria-labelledby="quiz-audit-cta-heading">
              <div>
                <p class="quiz-eyebrow">Go beyond the self-assessment</p>
                <h3 id="quiz-audit-cta-heading">Get a personalized review of your actual systems.</h3>
                <p>The Free Business Systems Audit reviews where the business may be losing time, leads, or money, then delivers a one-page scorecard and three prioritized recommendations within three business days.</p>
              </div>
              <a
                class="button"
                href="/free-audit/?source=automation-quiz#book-audit"
                data-quiz-audit-cta
                data-analytics-cta="free-audit"
                data-analytics-event="free_audit_cta_clicked"
                data-analytics-location="automation-quiz-result"
              >Request Your Free Audit <span aria-hidden="true">↗</span></a>
            </section>

            <div class="quiz-result-actions">
              <button class="button button-secondary" type="button" data-retake-quiz>Retake the Quiz</button>
              <a class="button button-secondary" href="/resources/">Explore More Free Resources</a>
            </div>
            <p class="quiz-disclaimer">This self-assessment is directional and based only on the answers provided. It does not guarantee savings, revenue, compliance, or implementation results.</p>
          </section>
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<script>
  import { automationQuiz, type AutomationQuizAnswers } from "../data/automation-quiz";
  import { scoreAutomationQuiz, type AutomationQuizResult } from "../lib/automation-quiz-scoring";

  const progressStorageKey = "velixon_automation_quiz_progress";
  const handoffStorageKey = "velixon_automation_quiz_handoff";
  const form = document.querySelector<HTMLFormElement>("#business-automation-quiz");
  const steps = Array.from(document.querySelectorAll<HTMLElement>("[data-question-step]"));
  const nextButton = document.querySelector<HTMLButtonElement>("[data-quiz-next]");
  const backButton = document.querySelector<HTMLButtonElement>("[data-quiz-back]");
  const submitButton = document.querySelector<HTMLButtonElement>("[data-quiz-submit]");
  const retakeButton = document.querySelector<HTMLButtonElement>("[data-retake-quiz]");
  const errorBox = document.querySelector<HTMLElement>("#quiz-error");
  const resultSection = document.querySelector<HTMLElement>("#quiz-result");
  const progress = document.querySelector<HTMLProgressElement>("[data-quiz-progress]");
  const currentQuestionLabel = document.querySelector<HTMLElement>("[data-current-question]");
  const analytics = () => (window as Window & {
    velixonAnalytics?: { track: (name: string, parameters?: Record<string, unknown>) => void };
  }).velixonAnalytics;

  let currentStep = 0;
  let quizStarted = false;
  let quizCompleted = false;
  let abandonmentTracked = false;
  const completedQuestionEvents = new Set<string>();

  const setText = (selector: string, value: string) => {
    const element = document.querySelector<HTMLElement>(selector);
    if (element) element.textContent = value;
  };

  const showError = (message: string) => {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.hidden = false;
    errorBox.focus();
  };

  const clearError = () => {
    if (!errorBox) return;
    errorBox.textContent = "";
    errorBox.hidden = true;
  };

  const trackCurrentQuestionCompleted = () => {
    const questionId = steps[currentStep]?.dataset.questionId || `question-${currentStep + 1}`;
    if (completedQuestionEvents.has(questionId)) return;
    completedQuestionEvents.add(questionId);
    analytics()?.track("quiz_step_completed", {
      quiz_name: "business_automation_score",
      question_number: currentStep + 1,
      question_id: questionId
    });
  };

  const getAnswers = (): AutomationQuizAnswers => {
    if (!form) return {};
    return Object.fromEntries(
      automationQuiz.questions
        .map((question) => [
          question.id,
          form.querySelector<HTMLInputElement>(`input[name="${question.id}"]:checked`)?.value ?? ""
        ])
        .filter(([, value]) => Boolean(value))
    ) as AutomationQuizAnswers;
  };

  const saveProgress = () => {
    try {
      sessionStorage.setItem(progressStorageKey, JSON.stringify({
        version: automationQuiz.version,
        updatedAt: new Date().toISOString(),
        currentStep,
        answers: getAnswers()
      }));
    } catch {
      // The quiz remains usable when browser storage is unavailable.
    }
  };

  const restoreProgress = () => {
    if (!form) return;
    try {
      const saved = JSON.parse(sessionStorage.getItem(progressStorageKey) || "null") as {
        version?: string;
        currentStep?: number;
        answers?: Record<string, string>;
      } | null;
      if (!saved || saved.version !== automationQuiz.version || !saved.answers) return;

      Object.entries(saved.answers).forEach(([questionId, optionId]) => {
        form.querySelectorAll<HTMLInputElement>(`input[name="${CSS.escape(questionId)}"]`).forEach((input) => {
          input.checked = input.value === optionId;
        });
      });
      if (Number.isInteger(saved.currentStep)) {
        currentStep = Math.max(0, Math.min(Number(saved.currentStep), steps.length - 1));
      }
    } catch {
      // Ignore unavailable or malformed optional progress data.
    }
  };

  const renderStep = (moveFocus = false) => {
    steps.forEach((step, index) => { step.hidden = index !== currentStep; });
    if (currentQuestionLabel) currentQuestionLabel.textContent = String(currentStep + 1);
    if (progress) progress.value = currentStep + 1;
    if (backButton) backButton.hidden = currentStep === 0;
    if (nextButton) nextButton.hidden = currentStep === steps.length - 1;
    if (submitButton) submitButton.hidden = currentStep !== steps.length - 1;

    if (moveFocus) {
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.querySelector<HTMLElement>(".quiz-card")?.scrollIntoView({
        behavior: prefersReducedMotion ? "auto" : "smooth",
        block: "start"
      });
      window.setTimeout(() => steps[currentStep]?.querySelector<HTMLElement>("h2")?.focus({ preventScroll: true }), prefersReducedMotion ? 0 : 220);
    }
  };

  const validateCurrentQuestion = () => {
    const questionId = steps[currentStep]?.dataset.questionId;
    if (!questionId || !form?.querySelector(`input[name="${CSS.escape(questionId)}"]:checked`)) {
      showError("Choose the answer that best matches your current process.");
      steps[currentStep]?.querySelector<HTMLInputElement>("input[type='radio']")?.focus();
      return false;
    }
    clearError();
    return true;
  };

  const renderResult = (result: AutomationQuizResult) => {
    setText("[data-result-score]", String(result.score));
    setText("[data-result-level]", `${result.level.label} automation maturity`);
    setText("[data-result-title]", `Your business is at the ${result.level.label.toLowerCase()} stage.`);
    setText("[data-result-summary]", result.level.summary);

    const categoryContainer = document.querySelector<HTMLElement>("[data-category-results]");
    if (categoryContainer) {
      categoryContainer.replaceChildren(...result.categoryScores.map((category) => {
        const article = document.createElement("article");
        const headingRow = document.createElement("div");
        const label = document.createElement("strong");
        const score = document.createElement("span");
        const meter = document.createElement("progress");
        label.textContent = category.label;
        score.textContent = `${category.score}/100`;
        meter.max = 100;
        meter.value = category.score;
        meter.setAttribute("aria-label", `${category.label}: ${category.score} out of 100`);
        headingRow.append(label, score);
        article.append(headingRow, meter);
        return article;
      }));
    }

    const weaknessList = document.querySelector<HTMLOListElement>("[data-result-weaknesses]");
    if (weaknessList) {
      weaknessList.replaceChildren(...result.weaknesses.map((weakness) => {
        const item = document.createElement("li");
        const label = document.createElement("strong");
        const score = document.createElement("span");
        label.textContent = weakness.label;
        score.textContent = `${weakness.score}/100`;
        item.append(label, score);
        return item;
      }));
    }

    const recommendationList = document.querySelector<HTMLUListElement>("[data-result-recommendations]");
    if (recommendationList) {
      recommendationList.replaceChildren(...result.recommendations.map((recommendation) => {
        const item = document.createElement("li");
        item.textContent = recommendation;
        return item;
      }));
    }
  };

  const completeQuiz = () => {
    const answers = getAnswers();
    const result = scoreAutomationQuiz(answers);
    if (!result.complete) {
      showError("Answer every question before calculating your score.");
      return;
    }

    renderResult(result);
    const handoff = {
      version: result.version,
      completedAt: new Date().toISOString(),
      score: result.score,
      level: result.level.label,
      categoryScores: Object.fromEntries(result.categoryScores.map((category) => [category.id, category.score])),
      weaknesses: result.weaknesses.map((weakness) => weakness.label),
      answers
    };

    try {
      sessionStorage.setItem(handoffStorageKey, JSON.stringify(handoff));
      sessionStorage.removeItem(progressStorageKey);
    } catch {
      // The result remains visible even when the optional handoff cannot be stored.
    }

    quizCompleted = true;
    if (form) form.hidden = true;
    if (resultSection) {
      resultSection.hidden = false;
      resultSection.focus();
    }
    analytics()?.track("quiz_completed", {
      quiz_name: "business_automation_score",
      score_band: Math.floor(result.score / 10) * 10,
      maturity_level: result.level.label.toLowerCase().replaceAll(" ", "_")
    });
    window.history.replaceState({}, "", "/automation-assessment/?completed=true");
  };

  const restoreCompletedResult = () => {
    if (new URLSearchParams(window.location.search).get("completed") !== "true") return false;
    try {
      const handoff = JSON.parse(sessionStorage.getItem(handoffStorageKey) || "null") as {
        version?: string;
        answers?: AutomationQuizAnswers;
      } | null;
      if (!handoff || handoff.version !== automationQuiz.version || !handoff.answers) return false;
      const restoredResult = scoreAutomationQuiz(handoff.answers);
      if (!restoredResult.complete) return false;
      renderResult(restoredResult);
      quizCompleted = true;
      if (form) form.hidden = true;
      if (resultSection) resultSection.hidden = false;
      return true;
    } catch {
      return false;
    }
  };

  const markStarted = () => {
    if (quizStarted || quizCompleted) return;
    quizStarted = true;
    analytics()?.track("quiz_started", { quiz_name: "business_automation_score" });
  };

  nextButton?.addEventListener("click", () => {
    markStarted();
    if (!validateCurrentQuestion()) return;
    trackCurrentQuestionCompleted();
    currentStep = Math.min(currentStep + 1, steps.length - 1);
    saveProgress();
    renderStep(true);
  });

  backButton?.addEventListener("click", () => {
    clearError();
    currentStep = Math.max(0, currentStep - 1);
    saveProgress();
    renderStep(true);
  });

  form?.addEventListener("change", () => {
    markStarted();
    clearError();
    saveProgress();
  });

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    markStarted();
    if (!validateCurrentQuestion()) return;
    trackCurrentQuestionCompleted();
    completeQuiz();
  });

  retakeButton?.addEventListener("click", () => {
    form?.reset();
    currentStep = 0;
    quizStarted = false;
    quizCompleted = false;
    abandonmentTracked = false;
    completedQuestionEvents.clear();
    clearError();
    try {
      sessionStorage.removeItem(progressStorageKey);
      sessionStorage.removeItem(handoffStorageKey);
    } catch {
      // Retaking still works without browser storage.
    }
    if (form) form.hidden = false;
    if (resultSection) resultSection.hidden = true;
    window.history.replaceState({}, "", "/automation-assessment/");
    renderStep(true);
  });

  window.addEventListener("pagehide", () => {
    if (!quizStarted || quizCompleted || abandonmentTracked) return;
    abandonmentTracked = true;
    analytics()?.track("quiz_abandoned", {
      quiz_name: "business_automation_score",
      last_question: currentStep + 1
    });
  });

  if (!restoreCompletedResult()) {
    restoreProgress();
    renderStep();
  }
</script>
