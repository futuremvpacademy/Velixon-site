---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import { siteContent } from "../../data/site";
import { checklists } from "../../data/checklists";
import "../../styles/resources.css";

const { companyName, logo, nav, cta } = siteContent;
const featuredAudit = {
  title: "Free Business Systems Audit",
  description: "A personalized one-page scorecard and three prioritized recommendations, delivered within three business days.",
  href: "/free-audit/#book-audit",
  category: "Personalized assessment"
};
const quizResource = {
  title: "What’s Your Business Automation Score?",
  description: "Answer ten questions and get an immediate score, category breakdown, and next steps.",
  href: "/automation-assessment/",
  category: "Three-minute quiz"
};
const phaseOneResources = [
  {
    title: "AI Automation ROI Calculator",
    description: "Estimate labor, implementation, and operating cost across three scenarios.",
    href: "/resources/ai-automation-roi-calculator/",
    category: "Interactive business tool"
  },
  {
    title: "What Is Business Process Automation?",
    description: "Learn how automation coordinates people, rules, systems, and exceptions.",
    href: "/resources/what-is-business-process-automation/",
    category: "Automation fundamentals"
  },
  {
    title: "How Much Does AI Automation Cost?",
    description: "See what shapes scope, risk, and a realistic first-year budget.",
    href: "/resources/how-much-does-ai-automation-cost/",
    category: "AI investment planning"
  },
  {
    title: "How to Know When Your Business Needs Custom Software",
    description: "Use clear signals to decide whether to buy, improve, or build.",
    href: "/resources/when-business-needs-custom-software/",
    category: "Software strategy"
  }
];
const extendedResources = [
  {
    title: "Custom Software ROI: A Practical Cost and Value Guide",
    description: "Compare total cost, operating value, risk, and time to impact.",
    href: "/resources/custom-software-roi-cost/",
    category: "Investment planning"
  },
  {
    title: "When to Replace Spreadsheets with Custom Software",
    description: "Spot when a spreadsheet becomes a system risk and plan the transition.",
    href: "/resources/replace-spreadsheets-custom-software/",
    category: "Operations"
  },
  {
    title: "How to Identify High-Value AI Automation Workflows",
    description: "Rank opportunities by friction, readiness, risk, and measurable value.",
    href: "/resources/high-value-ai-automation-workflows/",
    category: "Applied AI"
  },
  {
    title: "Custom Software vs. SaaS: A Decision Guide",
    description: "Compare fit, ownership, integrations, change, and long-term economics.",
    href: "/resources/custom-software-vs-saas/",
    category: "Technology strategy"
  }
];
const resourceCollections = [
  {
    title: "AI & Automation Guides",
    description: "Answer-first guidance for workflows, AI systems, ROI, and internal software.",
    href: "/guides/",
    category: "Educational library",
    linkLabel: "Browse guides"
  },
  {
    title: "Software & Automation Comparisons",
    description: "Compare platforms and operating models against real business constraints.",
    href: "/comparisons/",
    category: "Decision library",
    linkLabel: "Compare options"
  },
  {
    title: "Product Case Studies",
    description: "See how Velixon products turn fragmented workflows into connected systems.",
    href: "/case-studies/",
    category: "Product evidence",
    linkLabel: "View case studies"
  }
];

const checklistDescriptions: Record<string, string> = {
  "website-conversion": "Check clarity, trust, mobile usability, accessibility, and measurement.",
  "lead-follow-up": "Check response speed, ownership, follow-up, pipeline visibility, and reporting.",
  "business-automation": "Check process fit, data, exceptions, ownership, monitoring, and value.",
  operations: "Check scheduling, handoffs, information quality, workload, and resilience."
};
const linkedChecklistResources = checklists.map((checklist) => ({
  title: checklist.title,
  displayTitle: checklist.shortTitle,
  description: checklistDescriptions[checklist.slug] ?? checklist.description,
  href: `/resources/checklists/${checklist.slug}/`,
  category: "Interactive checklist"
}));
const planningResources = [...phaseOneResources, ...extendedResources];
const schemaResources = [
  featuredAudit,
  quizResource,
  ...linkedChecklistResources,
  ...planningResources,
  ...resourceCollections
];
const collectionSchema = {
  "@type": "CollectionPage",
  "@id": "https://velixon.net/resources/#collection",
  name: "Free Velixon Business Tools and Resources",
  description: "Start with a personalized business systems audit or use practical quizzes, checklists, calculators, and guides for smarter business systems.",
  url: "https://velixon.net/resources/",
  isPartOf: { "@id": "https://velixon.net/#website" },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: schemaResources.map((resource, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: resource.title,
      url: `https://velixon.net${resource.href}`
    }))
  }
};
---

<MainLayout
  title="Free Business Audit, Quiz, Checklists & Guides | Velixon"
  description="Start with a personalized Velixon business systems audit or explore practical automation quizzes, checklists, calculators, and guides."
  imageAlt="Free Velixon business audit, quiz, checklists, and resources"
  schema={collectionSchema}
>
  <Navbar companyName={companyName} logo={logo} nav={nav} cta={cta} currentPath="/resources" />
  <main id="main-content" class="resources-page">
    <section class="resources-hero">
      <div class="resource-orb resource-orb-one" aria-hidden="true"></div>
      <div class="resource-orb resource-orb-two" aria-hidden="true"></div>
      <div class="container resources-hero-shell">
        <p class="eyebrow">Free audit + practical tools</p>
        <h1>Find what to improve first.</h1>
        <p class="resources-hero-copy">Start with a personalized audit, or use focused tools to assess, plan, and compare your next move.</p>
        <div class="resources-hero-actions">
          <a class="button" href="/free-audit/?source=resources-hero#book-audit" data-analytics-cta="free-audit" data-analytics-event="free_audit_cta_clicked" data-analytics-location="resources-hero">Request Your Free Audit</a>
          <a class="button button-secondary" href="#assess">Browse the Tools</a>
        </div>
        <div class="resources-hero-proof" aria-label="Free audit benefits">
          <span>Personalized scorecard</span>
          <span>3 prioritized recommendations</span>
          <span>Within 3 business days</span>
        </div>
      </div>
    </section>

    <section class="resources-section resources-assess" id="assess" aria-labelledby="assess-heading">
      <div class="container">
        <div class="resource-section-heading">
          <div>
            <p class="eyebrow">Assess</p>
            <h2 id="assess-heading">See where the friction is.</h2>
          </div>
          <p class="resource-section-note">Use a quick score or a focused checklist.</p>
        </div>
        <div class="resources-assess-grid">
          <article class="resources-quiz-feature">
            <div>
              <p class="resource-card-category">Fast self-assessment</p>
              <h3>{quizResource.title}</h3>
              <p>{quizResource.description}</p>
            </div>
            <div class="resources-quiz-summary" aria-label="Quiz results include">
              <span><strong>10</strong> questions</span>
              <span><strong>0–100</strong> score</span>
              <span><strong>5</strong> categories</span>
            </div>
            <a class="button" href={quizResource.href} data-analytics-cta>Take the Quiz <span aria-hidden="true">→</span></a>
          </article>

          <div class="resources-checklist-panel" id="checklists">
            <div class="resources-subheading">
              <div><p class="resource-card-category">Interactive checklists</p><h3>Check one workflow at a time.</h3></div>
              <p>No email required. Progress stays on your device.</p>
            </div>
            <div class="resource-card-grid resources-checklist-grid">
              {linkedChecklistResources.map((checklist) => (
                <article class="resource-card resource-tool-card">
                  <p class="resource-card-category">{checklist.category}</p>
                  <h3><a href={checklist.href}>{checklist.displayTitle}</a></h3>
                  <p>{checklist.description}</p>
                  <a class="resource-card-link" href={checklist.href} aria-label={`Open ${checklist.title}`}>Open checklist <span aria-hidden="true">→</span></a>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="resources-section resources-plan" id="plan" aria-labelledby="plan-heading">
      <div class="container">
        <div class="resource-section-heading">
          <div>
            <p class="eyebrow">Plan</p>
            <h2 id="plan-heading">Make the next decision clearly.</h2>
          </div>
          <p class="resource-section-note">Costs, readiness, ROI, and build strategy.</p>
        </div>
        <div class="resource-card-grid resources-plan-grid">
          {planningResources.map((resource) => (
            <article class="resource-card">
              <p class="resource-card-category">{resource.category}</p>
              <h3><a href={resource.href}>{resource.title}</a></h3>
              <p>{resource.description}</p>
              <a class="resource-card-link" href={resource.href} aria-label={`Open ${resource.title}`}>Read guide <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="resources-section resources-explore" id="explore" aria-labelledby="explore-heading">
      <div class="container">
        <div class="resource-section-heading">
          <div>
            <p class="eyebrow">Compare &amp; explore</p>
            <h2 id="explore-heading">Choose with better evidence.</h2>
          </div>
          <p class="resource-section-note">Guides, comparisons, and first-party product evidence.</p>
        </div>
        <div class="resource-card-grid resource-card-grid-three">
          {resourceCollections.map((collection) => (
            <article class="resource-card">
              <p class="resource-card-category">{collection.category}</p>
              <h3><a href={collection.href}>{collection.title}</a></h3>
              <p>{collection.description}</p>
              <a class="resource-card-link" href={collection.href} aria-label={`${collection.linkLabel}: ${collection.title}`}>{collection.linkLabel} <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</MainLayout>
