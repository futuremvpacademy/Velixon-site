# Add a measurement ID only after ownership of the Analytics property is verified.
# Analytics stays disabled when this value is blank.
PUBLIC_GA_MEASUREMENT_ID=
# Optional consent-gated destinations. Leave blank until each account and ID is
# verified. Do not configure a GA4 tag in GTM when direct GA4 is also enabled.
PUBLIC_GTM_CONTAINER_ID=
PUBLIC_CLARITY_PROJECT_ID=
# Optional direct Google Ads conversion destination. These identifiers are
# public configuration, not secrets. Leave all blank when GTM owns the Google
# Ads conversion tags to prevent duplicate conversions.
PUBLIC_GOOGLE_ADS_CONVERSION_ID=
PUBLIC_GOOGLE_ADS_AUDIT_CONVERSION_LABEL=
# Optional Search Console HTML-tag verification token. Configure the real value
# only in the deployment provider; do not commit even public account identifiers.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Conversion-page configuration.
PUBLIC_LINKEDIN_URL=
PUBLIC_AUTOMATION_AUDIT_HERO_VARIANT=A

# Optional Free Audit email delivery. Audit submissions are still stored in
# Netlify Blobs when these values are blank; email notifications are skipped.
# Keep the API key private in Netlify. In production, set all three email fields
# below to the approved velixon@velixon.net mailbox. Example files remain blank
# so the repository secret scanner can enforce one consistent policy.
# Never use a PUBLIC_ prefix for any of these values.
RESEND_API_KEY=
AUDIT_FROM_EMAIL=
AUDIT_NOTIFICATION_EMAIL=
AUDIT_REPLY_TO_EMAIL=
