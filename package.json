{
  "name": "velixon-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "typecheck": "astro check && tsc --noEmit --ignoreDeprecations 6.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "node scripts/clean-dist.mjs && astro build && node scripts/clean-generated-conflicts.mjs",
    "build:netlify": "npm run check:free-audit-config && npm run build",
    "preview": "astro preview",
    "verify:legal": "npm run verify:security",
    "verify:security": "npm run audit:dependencies && npm --prefix velixon-video run lint && npm run verify && npm run audit:security && npm run audit:secrets",
    "check:free-audit-config": "node --import tsx scripts/check-free-audit-config.ts",
    "audit:seo": "node scripts/audit-site.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "audit:security": "node scripts/audit-security.mjs",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "audit:secret-history": "node scripts/audit-secret-history.mjs",
    "verify": "npm run typecheck && npm test && npm run check:free-audit-config && npm run build && npm run audit:seo"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/host-grotesk": "^5.3.0",
    "@fontsource/gloock": "^5.3.0",
    "@netlify/blobs": "10.7.12",
    "@netlify/functions": "^5.3.0",
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
